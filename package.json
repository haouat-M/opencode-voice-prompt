{
  "name": "opencode-voice-prompt",
  "version": "2.3.0",
  "description": "In-app voice dictation for OpenCode Desktop: a microphone pill above the prompt composer that inserts Arabic/multilingual speech into the prompt",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./gui-experimental": "./gui-experimental.cjs"
  },
  "files": [
    "index.js",
    "correction.mjs",
    "gui-experimental.cjs",
    "scripts/engine.py",
    "tests/*.py",
    "legacy/*.py",
    "legacy/*.bat",
    "legacy/README.md",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node --check index.js && node --check gui-experimental.cjs && node --check correction.mjs",
    "test": "python -m unittest discover -s tests -v && node --test",
    "test:js": "node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "voice",
    "speech-to-text",
    "arabic",
    "dictation",
    "speech",
    "developer-tools"
  ],
  "author": "haouat-M",
  "license": "MIT",
  "dependencies": {
    "@opencode/plugin": "^2.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haouat-M/opencode-voice-prompt.git"
  },
  "bugs": {
    "url": "https://github.com/haouat-M/opencode-voice-prompt/issues"
  },
  "homepage": "https://github.com/haouat-M/opencode-voice-prompt#readme"
}
